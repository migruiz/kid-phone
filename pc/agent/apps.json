  "_comment": "Every app on the PC is switchable from the parents' app. Packaged (Store) apps are found automatically. Desktop programs (browsers, Roblox) are listed below. The tools in defaultOn start switched on. The apps in blockPackaged/blockDesktop are never offered and stay blocked: they would let him leave the locked setup.",

  "defaultOn": [
    "microsoft.windowscalculator", "microsoft.windowsnotepad", "microsoft.paint",
    "microsoft.mspaint", "microsoft.windows.photos", "microsoft.windowscamera", "microsoft.screensketch"
  ],

  "blockPackaged": [
    "Microsoft.WindowsTerminal", "Microsoft.WindowsStore", "MicrosoftCorporationII.QuickAssist",
    "Microsoft.Windows.DevHome", "Microsoft.PowerAutomateDesktop", "Microsoft.SecHealthUI",
    "microsoft.windowscommunicationsapps"
  ],

  "blockDesktop": ["git-bash", "git-cmd", "git-gui", "node", "tailscale-ipn"],

  "desktop": [
    { "id": "roblox", "label": "Roblox",
      "launch": "%LOCALAPPDATA%\\Roblox\\Versions\\*\\RobloxPlayerBeta.exe",
      "processes": ["RobloxPlayerBeta", "RobloxPlayerLauncher", "RobloxCrashHandler", "RobloxPlayerInstaller", "RobloxStudioBeta"],
      "signerWide": true },
    { "id": "chrome", "label": "Google Chrome",
      "launch": "C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe",
      "processes": ["chrome"] },
    { "id": "msedge", "label": "Microsoft Edge",
      "launch": "C:\\Program Files (x86)\\Microsoft\\Edge\\Application\\msedge.exe",
      "processes": ["msedge"] }
  ],

